<Window
    x:Class="DownloaderApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Downloader">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Padding="24,20"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <StackPanel>
                <TextBlock
                    Text="Downloader Beta"
                    FontSize="28"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Margin="0,4,0,0"
                    Text="Descarga videos y audio fácilmente"
                    Opacity="0.65"
                    FontSize="14"/>
            </StackPanel>

        </Border>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1">
            <Grid
                Padding="40"
                HorizontalAlignment="Center"
                MaxWidth="1000">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- URL -->
                <StackPanel
                    Grid.Row="0"
                    Spacing="12">

                    <TextBlock
                        Text="Introduce la URL del video que quieres descargar."
                        FontSize="20"
                        FontWeight="SemiBold"/>

                    <Grid Margin="0,8,0,0"
                      HorizontalAlignment="Left">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="600"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="UrlTextBox"
                                            Grid.Column="0"
                                            Width="600"
                                            MinHeight="44"
                                            MaxHeight="120"
                                            TextWrapping="Wrap"
                                            Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="https://www.youtube.com/watch?v=..."
                                            VerticalContentAlignment="Center"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                        <Button
                            x:Name="AnalyzeButton"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Width="44"
                            Height="44"
                            VerticalAlignment="Top"
                            Command="{Binding AnalyzeCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Analizar enlace">

                            <FontIcon Glyph="&#xE721;" />
                        </Button>
                    </Grid>

                    <!-- Estado del análisis -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">

                        <ProgressRing
                            Width="18"
                            Height="18"
                            IsActive="{Binding IsBusy}"/>

                        <TextBlock
                            Text="{Binding StatusMessage}"
                            VerticalAlignment="Center"
                            Opacity="0.65"/>

                    </StackPanel>

                </StackPanel>

                <!-- Información del video -->
                <Border
                    x:Name="MediaInfoCard"
                    Grid.Row="1"
                    Margin="0,32,0,0"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    Visibility="{Binding MediaDetailsVisibility}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail -->
                        <Border
                            Grid.Column="0"
                            Width="220"
                            Height="124"
                            CornerRadius="8"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">

                            <Image
                                Source="{Binding ThumbnailUrl}"
                                Stretch="UniformToFill"/>

                        </Border>

                        <!-- Datos -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="8">

                            <TextBlock
                                x:Name="VideoTitleText"
                                Text="{Binding VideoTitle}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                x:Name="UploaderText"
                                Text="{Binding Uploader}"
                                Opacity="0.65"/>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <TextBlock
                                    Text="Duración:"
                                    Opacity="0.65"/>

                                <TextBlock
                                    x:Name="DurationText"
                                    Text="{Binding DurationText}"/>

                            </StackPanel>

                        </StackPanel>
                    </Grid>

                </Border>

                <!-- Opciones de descarga -->
                <Border
    Grid.Row="2"
    Margin="0,20,0,40"
    Padding="20"
    CornerRadius="12"
    BorderThickness="1"
    Visibility="{Binding MediaDetailsVisibility}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <!-- Título -->
                            <RowDefinition Height="Auto"/>

                            <!-- Formato / calidad / botón -->
                            <RowDefinition Height="Auto"/>

                            <!-- Progreso -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Título -->
                        <TextBlock
            Grid.Row="0"
            Text="Opciones de descarga"
            FontSize="18"
            FontWeight="SemiBold"/>

                        <!-- Opciones -->
                        <Grid
            Grid.Row="1"
            Margin="0,18,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Formato -->
                            <ComboBox
                Grid.Column="0"
                Header="Formato"
                PlaceholderText="Tipo"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding OutputFormats}"
                SelectedItem="{Binding SelectedOutputFormat, Mode=TwoWay}"
                DisplayMemberPath="Name"/>

                            <!-- Calidad -->
                            <ComboBox
                Grid.Column="1"
                Margin="12,0,0,0"
                Header="Calidad"
                PlaceholderText="Selecciona una calidad"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Qualities}"
                SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                DisplayMemberPath="DisplayName"/>

                            <!-- Descargar -->
                            <Button
                x:Name="DownloadButton"
                Grid.Column="2"
                Margin="16,24,0,0"
                Width="44"
                Height="44"
                VerticalAlignment="Top"
                Command="{Binding DownloadCommand}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Descargar">

                                <FontIcon Glyph="&#xE896;"/>

                            </Button>

                        </Grid>

                        <!-- Progreso de descarga -->
                        <StackPanel
            Grid.Row="2"
            Margin="0,18,0,0"
            Spacing="8"
                            Visibility="{Binding DownloadProgressVisibility}">

                            <ProgressBar
                Minimum="0"
                Maximum="100"
                Value="{Binding DownloadPercentage}"
                HorizontalAlignment="Stretch"
                Height="4"/>

                            <TextBlock
                Text="{Binding DownloadStatus}"
                Opacity="0.65"
                FontSize="12"/>

                        </StackPanel>
                        <InfoBar
                        Grid.Row="3"
                        Margin="0,16,0,0"
                        IsOpen="{Binding IsDownloadCompletedMessageOpen, Mode=TwoWay}"
                        Severity="Success"
                        Title="Descarga finalizada"
                        Message="El archivo se descargó correctamente."
                        IsClosable="True"/>
                    </Grid>

                </Border>

            </Grid>
        </ScrollViewer>

    </Grid>

</Window>